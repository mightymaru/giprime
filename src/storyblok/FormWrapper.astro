---
import { storyblokEditable } from "@storyblok/astro";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";

const { blok } = Astro.props;
---
<div class="flex justify-center p-12">
    <form 
      name="contact" 
      method="POST" 
      netlify 
      data-netlify="true" 
			netlify-honeypot="bot-field"
      class="flex flex-col w-[400px]" 
      {...storyblokEditable(blok)}
    >
        <!-- Required hidden field for Netlify submission routing -->
        <input type="hidden" name="form-name" value="contact" />
				
				<p class="hidden">
					<label>
						Don’t fill this out if you’re human: <input name="bot-field" type="text" />
					</label>
				</p>

        {
            blok.forms?.map((blok) => {
              return <StoryblokComponent blok={blok} />;
            })
        }
        
        <button
            type="submit"
            class="w-full rounded-[8px] bg-primary px-6 py-2.5 text-xs font-medium uppercase leading-tight text-white shadow-md transition duration-150 ease-in-out bg-[#00b3b0] hover:bg-[#1e7bc3] hover:shadow-lg focus:bg-[#1e7bc3] focus:shadow-lg focus:outline-none focus:ring-0 active:bg-[#1e7bc3] active:shadow-lg"
        >
          Send
        </button>
    </form>
</div>
